{
  "name": "carplayground",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "dev-nolog": "npm run dev",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate-content.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run validate && npm run typecheck && vite build",
    "build-nolog": "npm run build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "release:preview": "node scripts/preview-release.mjs",
    "release:backup": "node scripts/backup-release.mjs",
    "release:compose": "node scripts/compose-release.mjs",
    "test:release": "node --test tests/release.integration.mjs",
    "audit:audio": "python scripts/audit-audio.py",
    "audio:plan": "python scripts/generate-licensed-audio.py --plan"
  },
  "dependencies": {
    "dexie": "4.4.6",
    "howler": "2.2.4",
    "lucide-react": "1.59.0",
    "phaser": "4.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/howler": "2.2.13",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.6",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
