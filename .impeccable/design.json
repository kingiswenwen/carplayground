  "narrative": {
    "northStar": "可以亲手探索的汽车小镇",
    "overview": "圆润的微缩建筑、道路和道具构成孩子可辨认的世界。实际教学区域优先保证物体、目标轮廓、手势和现象可见。",
    "keyCharacteristics": [
      "建筑入口、物件图标和直接操作先于文字说明。",
      "明确轮廓、柔和阴影、足够大的常用控件。",
      "页面、地点、故事与玩法共用暖色底和低干扰工具。"
    ],
    "rules": [
      {
        "name": "The Teaching Colour Rule",
        "body": "认颜色、规律和分类所用的红、蓝、白来自原教学内容。",
        "section": "colors"
      },
      {
        "name": "The Object First Rule",
        "body": "标题和短句帮助陪玩者理解，孩子无需读懂文字才能选择建筑、抓取物体或进入故事活动。",
        "section": "typography"
      }
    ],
    "dos": [
      "保持教学目标、操作对象、命中范围、示范和反馈共同校对。",
      "复用登记车型与来源记录，保留同车图片回退和保存重试。"
    ],
    "donts": [
      "用装饰图片的车位或道路替代实际规则引擎中的对象。",
      "给开放表达与创作自动标注能力、得分或知识掌握。",
      "让换视图、镜头调整或切屏重置孩子进行中的活动。"
    ]
  }
